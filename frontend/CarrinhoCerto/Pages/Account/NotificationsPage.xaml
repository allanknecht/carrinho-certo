<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CarrinhoCerto.Pages.Account.NotificationsPage"
             Title="NotificationsPage"
             BackgroundColor="#F2F2F2"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Spacing="5"
                             Padding="30"
                             VerticalOptions="Center">
            
            <HorizontalStackLayout Margin="0, -20, 0, 30" HorizontalOptions="Start">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoltarTapped" />
                </HorizontalStackLayout.GestureRecognizers>

                <Label Text="←"
                       TextColor="#E80000"
                       FontFamily="PoppinsBlack"
                       FontSize="30"
                       VerticalOptions="Center"
                       Margin="0,-7,0,0"/>

                <Label Text="VOLTAR"
                       TextColor="#616161"
                       FontFamily="PoppinsBold"
                       FontSize="16"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Label Text="RECLAMES DO PLIM PLIM"
                    TextColor="#E80000"
                    FontSize="22"
                    FontFamily="PoppinsBlack"
                    HorizontalOptions="Center"
                    Margin="0,0,0,30" />

            <Label Text="Escolhe aí quando cê quer que a gente te dá um toque no celular."
                   TextColor="#616161"
                   FontFamily="PoppinsRegular"
                   FontSize="10"
                   Margin="0,-30,0,10"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <Label Text="Preço despencou"
                   FontAttributes="Bold"
                   TextColor="#616161"
                   Margin="5,20,0,0"
                   FontFamily="PoppinsBold"/>

            <Border Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="50"
                    Margin="0,0,0,20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="50, *">
                    <CheckBox
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     Color="#E80000"
                     IsChecked="True"/>

                    <Label Text="A gente grita se o arroz ou a carne caírem de preço pros itens das tuas listas."
                    Grid.Column="1"
                    FontSize="12"
                    TextColor="#616161"
                    BackgroundColor="Transparent"
                    FontFamily="PoppinsRegular"
                    HeightRequest="40"/>
                </Grid>
            </Border>

            <Label Text="Nota confirmada"
                   FontAttributes="Bold"
                   TextColor="#616161"
                   Margin="5,20,0,0"
                   FontFamily="PoppinsBold"/>

            <Border Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="50"
                    Margin="0,0,0,20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="50, *">
                    <CheckBox
                        x:Name="NotaConfirmadaCheck"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Color="#E80000"
                        IsChecked="True"/>

                    <Label Text="Avisa quando a nota que cê enviou bater no sistema e se espalhar por aí."
                            Grid.Column="1"
                            FontSize="12"
                            TextColor="#616161"
                            BackgroundColor="Transparent"
                            FontFamily="PoppinsRegular"
                            HeightRequest="40"/>
                </Grid>
            </Border>

            <Label Text="Promoções malucas"
                   FontAttributes="Bold"
                   TextColor="#616161"
                   Margin="5,20,0,0"
                   FontFamily="PoppinsBold"/>

            <Border Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="50"
                    Margin="0,0,0,20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="50, *">
                    <CheckBox
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Color="#E80000"/>

                    <Label Text="Ofertas cabulosas dos mercados parceiros que valem a corrida no fim de semana."
                            Grid.Column="1"
                            FontSize="12"
                            TextColor="#616161"
                            BackgroundColor="Transparent"
                            FontFamily="PoppinsRegular"
                            HeightRequest="40"/>
                </Grid>
            </Border>

            <Button Text="SALVAR" 
                BackgroundColor="#E80000"
                TextColor="#fef035"
                FontAttributes="Bold"
                FontSize="25"
                CornerRadius="10"
                HeightRequest="55"
                Margin="0,10,0,20"
                Clicked="OnSalvarClicked"
                FontFamily="PoppinsBlack"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>